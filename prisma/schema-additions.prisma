model SiteWork {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date      DateTime
  kind      String
  note      String?
  cost      Decimal? @db.Decimal(14, 2)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([siteId, date])
}

model SitePhoto {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fileId    String
  caption   String?
  takenAt   DateTime?
  createdAt DateTime @default(now())

  @@index([siteId])
}

