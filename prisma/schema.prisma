// ==========================================================
// ИЗЛК — схема базы данных
// Система хранения договоров и проектной документации
// для компании металлоконструкций
// ==========================================================

generator client {
  provider        = "prisma-client-js"
  // Без этого Prisma грузит include-связи отдельными последовательными запросами
  // (по одному на связь), а не одним SQL JOIN — на дашборде с 5+ связями это
  // даёт ~10 лишних round-trip'ов на каждую загрузку. Стабильно с Prisma 5.9+.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ПОЛЬЗОВАТЕЛИ И РОЛИ
// ------------------------------------------------------------

/// Роли пользователей системы.
/// ADMIN   — видит все договоры, суммы, настройки
/// MANAGER — видит только свои договоры, суммы видны, настройки закрыты
/// VIEWER  — видит только назначенные договоры, суммы скрыты
enum Role {
  ADMIN
  MANAGER
  DESIGNER
  /// Строитель: площадки, исполнительная документация, график проектирования КМ/КЖ/АР.
  BUILDER
  /// Производство: график производства.
  PRODUCTION
  /// Бухгалтерия: просмотр всех договоров и сумм, счета — отдельной задачей позже.
  ACCOUNTING
  /// Дизайнеры: просмотр всех договоров и сумм, без права редактирования.
  VIEWER_DESIGN
  VIEWER
}

/// Пользователь системы (сотрудник ИЗЛК)
model User {
  id           String    @id @default(cuid())
  /// Unique sign-in identifier; it is independent from a shared department mailbox.
  login        String    @unique
  /// A department mailbox can be shared by several employee accounts.
  email        String
  passwordHash String
  name         String
  role         Role      @default(MANAGER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Договоры, где этот пользователь — менеджер
  managedContracts  Contract[]       @relation("ContractManager")
  uploadedDocuments Document[]       @relation("DocumentUploader")
    auditLogs         AuditLog[]
    importEvents      ImportEvent[]
  contractAccess    ContractAccess[]
  responsibleFor    ProjectSection[] @relation("SectionResponsible")
  assignedTasks     Task[]           @relation("TaskAssignee")
  createdTasks      Task[]           @relation("TaskCreator")
  taskComments      TaskComment[]
  notifications     Notification[]
  stageChanges      ContractStageHistory[] @relation("StageChangedBy")
  stageComments     StageComment[]         @relation("StageCommentAuthor")
  pr1ConfirmedContracts Contract[] @relation("ContractPr1ConfirmedBy")
  chatMessages      ChatMessage[]

  @@index([email])
  @@index([role])
}

enum NotificationType {
  INFO
  ASSIGNMENT
  DEADLINE
  READY
  WARNING
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  message   String?
  href      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

enum BackgroundJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Журнал фоновых запусков. Он не заменяет AuditLog: это технический статус
/// планировщика, а не бизнес-аудит действий пользователя.
model BackgroundJob {
  id          String              @id @default(cuid())
  type        String
  startedAt   DateTime            @default(now())
  finishedAt  DateTime?
  status      BackgroundJobStatus @default(RUNNING)
  processed   Int                 @default(0)
  created     Int                 @default(0)
  error       String?

  @@index([type, startedAt])
  @@index([status, startedAt])
}

// ------------------------------------------------------------
// КОНТРАГЕНТЫ
// ------------------------------------------------------------

/// Юр. лицо или физ. лицо — от этого зависит, какие реквизиты нужны контрагенту.
enum ContractorType {
  LEGAL
  INDIVIDUAL
}

/// Контрагент (заказчик). Хранит псевдонимы для дедупликации —
/// в реальных папках одна и та же компания встречается под
/// разными названиями (ИП Дегтярев / Дегтярев С.В. и т.п.)
model Contractor {
  id        String         @id @default(cuid())
  name      String
  type      ContractorType @default(LEGAL)
  inn       String?
  address   String?
  phone     String?
  email     String?
  aliases   String[]       @default([]) // альтернативные названия для поиска дублей
  /// Реквизиты физ. лица — заполняются только когда type = INDIVIDUAL.
  snils              String?
  passportSeries     String?
  passportNumber     String?
  passportIssuedBy   String?
  passportIssuedAt   DateTime?
  passportDeptCode   String?
  /// Представитель по доверенности — отдельный человек, не сам заказчик.
  /// Заполняется, только если физ. лицо (type = INDIVIDUAL) в договоре
  /// действует через представителя; для юр. лиц и для физ. лиц без
  /// представителя все поля ниже пустые.
  representativeName                String?
  representativeSnils               String?
  representativePassportSeries      String?
  representativePassportNumber      String?
  representativePassportIssuedBy    String?
  representativePassportIssuedAt    DateTime?
  representativePassportDeptCode    String?
  representativeProxyNumber         String?
  representativeProxyDate           DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contracts Contract[]

  @@index([inn])
  @@index([name])
}

// ------------------------------------------------------------
// ДОГОВОРЫ
// ------------------------------------------------------------

enum ContractStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ContractKind {
  SMR
  MK
  PROJECT
}

/// Рабочая стадия живёт отдельно от административного статуса договора.
/// Это позволяет закрыть договор в архиве, не теряя ход фактических работ.
enum ContractWorkflowStage {
  CONTRACT_PREPARATION
  AWAITING_CONTRACT_SIGNATURE
  PR1_DEVELOPMENT
  AWAITING_PR1_SIGNATURE
  DESIGN
  WAITING_PRODUCTION
  PRODUCTION
  AWAITING_SHIPMENT
  SHIPPED
  INSTALL_KZH
  INSTALL_KM
  CLOSED
}

/// Договор — центральная сущность системы.
/// number — деловой номер (напр. "509-ИЗЛКРус-МК-2026")
/// cipher — технический шифр объекта (напр. "КБ-370.12.60.71.60"),
///          встречается в названиях файлов и папок на сервере
model Contract {
  id            String         @id @default(cuid())
  number        String         @unique
  cipher        String?
  contractorId  String
  contractor    Contractor     @relation(fields: [contractorId], references: [id])
  managerId     String?
  manager       User?          @relation("ContractManager", fields: [managerId], references: [id])
  date          DateTime
  amount        Decimal        @db.Decimal(15, 2)
  /// Разбивка общей стоимости для управленческой картины по договору.
  smrAmount     Decimal?       @db.Decimal(15, 2)
  mkAmount      Decimal?       @db.Decimal(15, 2)
  deliveryAmount Decimal?      @db.Decimal(15, 2)
  currency      String         @default("RUB")
  status        ContractStatus @default(ACTIVE)
  kind          ContractKind   @default(SMR)
  workflowStage ContractWorkflowStage @default(CONTRACT_PREPARATION)
  /// Срок по смете/договору в рабочих днях.
  workingDays   Int?
  /// Дата подписания Приложения №1 и рассчитанный общий дедлайн.
  pr1SignedAt   DateTime?
  pr1ConfirmedAt DateTime?
  pr1ConfirmedById String?
  pr1ConfirmedBy User? @relation("ContractPr1ConfirmedBy", fields: [pr1ConfirmedById], references: [id], onDelete: SetNull)
  deadline      DateTime?
  objectAddress String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime? // договоры не удаляются физически, только архивируются

  agreements      Agreement[]
  estimates       Estimate[]
  documents       Document[]
  sites           Site[]
  projectSections ProjectSection[]
  executiveDocs   ExecutiveDoc[]
  invoices        Invoice[]
  access          ContractAccess[]
  tasks           Task[]
  stageHistory    ContractStageHistory[]
  stageCommentLog StageComment[]
  chatThreads     ChatThread[]
  productionPlan  ProductionPlan?

  @@index([contractorId])
  @@index([managerId])
  @@index([number])
  @@index([cipher])
  @@index([kind])
  @@index([workflowStage])
  @@index([pr1ConfirmedById])
}

/// Неизменяемый журнал переходов по рабочим стадиям договора.
model ContractStageHistory {
  id           String                @id @default(cuid())
  contractId   String
  contract     Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fromStage    ContractWorkflowStage?
  toStage      ContractWorkflowStage
  changedById  String?
  changedBy    User?                 @relation("StageChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  isAutomatic  Boolean               @default(false)
  comment      String?
  createdAt    DateTime              @default(now())

  @@index([contractId, createdAt])
  @@index([changedById])
}

/// Обсуждение этапа договора — несколько сообщений на этап, не одна
/// перезаписываемая заметка. "Светофор" этапа зелёный, если по (contractId,
/// stage) есть хотя бы одна запись с deletedAt IS NULL.
model StageComment {
  id         String                @id @default(cuid())
  contractId String
  contract   Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  stage      ContractWorkflowStage
  authorId   String?
  author     User?                 @relation("StageCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Необязателен: комментарий может нести только фото подтверждения этапа,
  /// без текста (задача C3).
  text        String?                     @db.VarChar(1000)
  attachments StageCommentAttachment[]
  createdAt  DateTime              @default(now())
  deletedAt  DateTime?

  @@index([contractId, stage, createdAt])
  @@index([authorId])
}

/// Вложение к комментарию этапа (задача C3) — тот же паттерн, что и
/// ChatAttachment: подтверждение выполнения этапа фотографией — обычный
/// сценарий, отдельная модель вместо Document (тот жёстко про юридические
/// документы договора: kind/state/versioning, тут просто фото/файл к заметке).
model StageCommentAttachment {
  id          String       @id @default(cuid())
  commentId   String
  comment     StageComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileName    String
  storagePath String
  mimeType    String?
  sizeBytes   BigInt
  sha256      String
  isImage     Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([commentId])
}

enum ChatScope {
  DEPARTMENT
  CONTRACT
}

model ChatThread {
  id         String    @id @default(cuid())
  key        String    @unique
  scope      ChatScope
  department String?
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   ChatMessage[]

  @@index([scope, department])
  @@index([contractId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  /// Необязателен: сообщение может нести только вложение (фото с площадки),
  /// без подписи (задача C1).
  text        String?          @db.VarChar(4000)
  attachments ChatAttachment[]
  createdAt DateTime   @default(now())
  deletedAt DateTime?

  @@index([threadId, createdAt])
  @@index([authorId])
}

/// Вложение к сообщению чата (задача C1) — отдельная модель, не Document:
/// Document жёстко привязан к contractId, а чаты отделов вообще без
/// договора. Одно сообщение → много вложений (скрепка обычно даёт выбрать
/// сразу несколько файлов).
model ChatAttachment {
  id          String      @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  storagePath String
  mimeType    String?
  sizeBytes   BigInt
  sha256      String
  isImage     Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([messageId])
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/// Производственный паспорт договора. Технические характеристики временно
/// вносятся вручную, пока проект не отдаёт их в CRM структурированно.
model ProductionPlan {
  id                    String             @id @default(cuid())
  contractId            String             @unique
  contract              Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  buildingDimensions    String?
  requestNumber         String?
  frameMaterial         String?
  columnsSpec           String?
  roofSpec              String?
  ral                   String?
  frameWeight           Decimal?           @db.Decimal(15, 2)
  reinforcedConcreteWeight Decimal?         @db.Decimal(15, 2)
  galvanizedWeight      Decimal?           @db.Decimal(15, 2)
  blackMetalWeight      Decimal?           @db.Decimal(15, 2)
  locationOverride      String?
  note                  String?
  priority              ProductionPriority @default(NORMAL)
  pipeCutAt             DateTime?
  assemblyWeldingAt     DateTime?
  laserCutAt            DateTime?
  rollingAt             DateTime?
  paintingAt            DateTime?
  columnsPouringAt      DateTime?
  plannedShipmentAt     DateTime?
  actualShipmentAt      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([priority, plannedShipmentAt])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  category    String?
  dueDate     DateTime?
  priority    TaskPriority  @default(MEDIUM)
  status      TaskStatus    @default(TODO)
  contractId  String?
  contract    Contract?     @relation(fields: [contractId], references: [id])
  assigneeId  String
  assignee    User          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String
  creator     User          @relation("TaskCreator", fields: [creatorId], references: [id])
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  comments    TaskComment[]

  @@index([contractId])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([priority])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([authorId])
}

/// Доп. соглашение. parentId — ссылка на предыдущее ДС в цепочке
/// (Договор → ДС1 → ДС2 → ...)
model Agreement {
  id         String      @id @default(cuid())
  contractId String
  contract   Contract    @relation(fields: [contractId], references: [id])
  number     String
  date       DateTime
  parentId   String?
  parent     Agreement?  @relation("AgreementChain", fields: [parentId], references: [id])
  children   Agreement[] @relation("AgreementChain")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  estimates Estimate[]
  documents Document[]

  @@index([contractId])
  @@index([parentId])
  @@unique([contractId, number])
}

/// Смета. Может относиться к договору напрямую или к конкретному ДС.
model Estimate {
  id          String     @id @default(cuid())
  contractId  String
  contract    Contract   @relation(fields: [contractId], references: [id])
  agreementId String?
  agreement   Agreement? @relation(fields: [agreementId], references: [id])
  number      String
  date        DateTime
  amount      Decimal?   @db.Decimal(15, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  documents Document[]

  @@index([contractId])
  @@index([agreementId])
  @@unique([contractId, number])
}

/// Счёт на оплату — отдельная бизнес-сущность (не просто файл),
/// т.к. нужно отслеживать статус оплаты и строить отчёты "кто должен".
enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id         String        @id @default(cuid())
  contractId String
  contract   Contract      @relation(fields: [contractId], references: [id])
  number     String
  date       DateTime
  amount     Decimal       @db.Decimal(15, 2)
  status     InvoiceStatus @default(UNPAID)
  dueDate    DateTime?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  documents Document[]

  @@index([contractId])
  @@index([status])
}

// ------------------------------------------------------------
// ДОКУМЕНТЫ (универсальная таблица файлов)
// ------------------------------------------------------------

/// Тип документа. COMMERCIAL_PROPOSAL — просто тег на файле (КП),
/// без отдельной бизнес-логики, в отличие от Invoice.
enum DocumentKind {
  CONTRACT // сам договор
  AGREEMENT // доп. соглашение
  ESTIMATE // смета
  INVOICE // счёт на оплату
  COMMERCIAL_PROPOSAL // КП — коммерческое предложение
  APPENDIX // приложение
  PROJECT_PDF // проектная документация PDF (КМ/АР/КЖ)
  PROJECT_DWG // проектная документация DWG/чертежи
  EXECUTIVE // исполнительная документация
  ACT // акт скрытых работ / приёмки
  CERTIFICATE // сертификат
  SIGNED_SCAN // подписанный скан ("Подписано" в исходных папках)
  SOURCE_DATA // исходные данные от заказчика: ИГИ, ГПЗУ, топосъёмка и условия
  OTHER
}

enum DocumentState {
  SOURCE
  SIGNED
  ARCHIVE
}

/// Lifecycle of a commercial proposal.  It is stored on every document for a
/// compact schema, but is only shown and edited when kind is COMMERCIAL_PROPOSAL.
enum CommercialProposalStatus {
  DRAFT
  SENT
  WAITING_RESPONSE
  ACCEPTED
  REJECTED
}

/// Универсальная таблица для всех файлов.
/// Файл физически лежит на диске (storagePath), в БД — только путь.
model Document {
  id               String          @id @default(cuid())
  contractId       String
  contract         Contract        @relation(fields: [contractId], references: [id])
  agreementId      String?
  agreement        Agreement?      @relation(fields: [agreementId], references: [id])
  estimateId       String?
  estimate         Estimate?       @relation(fields: [estimateId], references: [id])
  invoiceId        String?
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id])
  projectSectionId String?
  projectSection   ProjectSection? @relation(fields: [projectSectionId], references: [id])
  executiveDocId   String?
  executiveDoc     ExecutiveDoc?   @relation(fields: [executiveDocId], references: [id])

  kind           DocumentKind
  state          DocumentState @default(SOURCE)
  version        Int           @default(1)
  fileName       String
  storagePath    String
  mimeType       String?
  sizeBytes      BigInt
  // The same certificate or drawing can be attached to different contracts.
  // Exact copies are rejected within one contract only.
  sha256         String
  signedAt       DateTime?
  isConfidential Boolean      @default(false)
  proposalStatus CommercialProposalStatus @default(DRAFT)
  proposalSentAt DateTime?
  proposalRespondedAt DateTime?
  uploadedById   String?
  uploadedBy     User?        @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([contractId])
  @@index([agreementId])
  @@index([estimateId])
  @@index([invoiceId])
  @@index([executiveDocId])
  @@index([sha256])
  @@unique([contractId, sha256])
  @@index([kind])
  @@index([kind, proposalStatus])
  @@index([contractId, state])
}

// ------------------------------------------------------------
// ПЛОЩАДКИ
// ------------------------------------------------------------

enum SiteStatus {
  PREPARING
  ISSUE
  READY
  BLOCKED
}

model Site {
  id         String     @id @default(cuid())
  contractId String
  contract   Contract   @relation(fields: [contractId], references: [id])
  address    String
  status     SiteStatus @default(PREPARING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  events SiteEvent[]
  works  SiteWork[]

  @@index([contractId])
  @@unique([contractId])
}

enum WorkDirection {
  KJ
  KM
}

model SiteWork {
  id            String        @id @default(cuid())
  siteId        String
  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  direction     WorkDirection
  workDate      DateTime
  stage         String
  crewCount     Int           @default(0)
  crewCost      Decimal       @default(0) @db.Decimal(15, 2)
  equipmentCost Decimal       @default(0) @db.Decimal(15, 2)
  materialCost  Decimal       @default(0) @db.Decimal(15, 2)
  otherCost     Decimal       @default(0) @db.Decimal(15, 2)
  comment       String?
  /// Browser-generated key makes a resumed mobile submission idempotent.
  clientSubmissionId String? @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  photos      SitePhoto[]
  crewEntries SiteCrewEntry[]
  costItems   SiteCostItem[]

  @@index([siteId, workDate])
  @@index([direction])
}

enum SiteCostCategory {
  EQUIPMENT
  MATERIAL
  OTHER
}

enum PaymentType {
  CASH
  CASHLESS
}

model SiteCrewEntry {
  id         String   @id @default(cuid())
  siteWorkId String
  siteWork   SiteWork @relation(fields: [siteWorkId], references: [id], onDelete: Cascade)
  name       String
  workDays   Decimal  @default(1) @db.Decimal(8, 2)
  rate       Decimal  @default(0) @db.Decimal(15, 2)
  createdAt  DateTime @default(now())

  @@index([siteWorkId])
}

model SiteCostItem {
  id          String           @id @default(cuid())
  siteWorkId  String
  siteWork    SiteWork         @relation(fields: [siteWorkId], references: [id], onDelete: Cascade)
  category    SiteCostCategory
  name        String
  paymentType PaymentType      @default(CASHLESS)
  quantity    Decimal          @default(1) @db.Decimal(15, 3)
  unit        String?
  unitPrice   Decimal          @default(0) @db.Decimal(15, 2)
  createdAt   DateTime         @default(now())

  @@index([siteWorkId, category])
}

model SitePhoto {
  id          String   @id @default(cuid())
  siteWorkId  String
  siteWork    SiteWork @relation(fields: [siteWorkId], references: [id], onDelete: Cascade)
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   BigInt
  sha256      String
  createdAt   DateTime @default(now())

  @@index([siteWorkId])
  @@index([sha256])
  @@unique([siteWorkId, sha256])
}

enum SiteEventType {
  INFO
  WARNING
  SUCCESS
}

/// Событие в таймлайне площадки. Каскадно удаляется при удалении Site.
model SiteEvent {
  id         String        @id @default(cuid())
  siteId     String
  site       Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type       SiteEventType
  text       String
  occurredAt DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@index([siteId])
}

// ------------------------------------------------------------
// РАЗДЕЛЫ ПРОЕКТА (КМ / АР / КЖ)
// ------------------------------------------------------------

enum SectionCode {
  KM // конструкции металлические
  AR // архитектурные решения
  KZH // конструкции железобетонные
  OTHER
}

enum ProjectQueueStatus {
  QUEUED
  IN_PROGRESS
  PAUSED
  DONE
}

model ProjectSection {
  id            String             @id @default(cuid())
  contractId    String
  contract      Contract           @relation(fields: [contractId], references: [id])
  code          SectionCode
  responsibleId String?
  responsible   User?              @relation("SectionResponsible", fields: [responsibleId], references: [id])
  dateFrom      DateTime?
  dateTo        DateTime?
  durationDays  Int                @default(5)
  deadline      DateTime?
  queuePosition Int                @default(0)
  queueStatus   ProjectQueueStatus @default(QUEUED)
  comment       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  documents Document[]

  @@index([contractId])
  @@index([code, responsibleId, queuePosition])
  @@unique([contractId, code])
}

// ------------------------------------------------------------
// ИСПОЛНИТЕЛЬНАЯ ДОКУМЕНТАЦИЯ
// ------------------------------------------------------------

enum ExecStatus {
  READY
  NOT_READY
  IN_PROGRESS
}

model ExecutiveDoc {
  id         String     @id @default(cuid())
  contractId String
  contract   Contract   @relation(fields: [contractId], references: [id])
  name       String
  status     ExecStatus @default(NOT_READY)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  documents  Document[]

  @@index([contractId])
  @@unique([contractId, name])
}

// ------------------------------------------------------------
// INBOX — полуавтоматический импорт файлов из сетевой папки
// ------------------------------------------------------------

enum InboxStatus {
  PENDING // не обработан
  SUGGESTED // скрипт предположил договор/тип, ждёт подтверждения человеком
  MATCHED // подтверждено и перенесено в Document
  IGNORED // мусор (Thumbs.db, ~$*, .bak и т.п.) или вручную отклонён
  FAILED // ошибка при обработке
}

/// Файл, найденный сканером на сетевой папке, но ещё не привязанный
/// к договору. sourcePath — путь на исходном сервере.
/// parsedContractNumber/parsedCipher — то, что скрипт вытащил из пути
/// регулярками (см. правила импорта). suggestedKind — предположение
/// по типу документа на основе родительской папки.
model InboxItem {
  id                   String        @id @default(cuid())
  sourcePath           String
  fileName             String
  sizeBytes            BigInt
  sha256               String
  status               InboxStatus   @default(PENDING)
  parsedContractNumber String?
  parsedCipher         String?
  suggestedKind        DocumentKind?
  matchedContractId    String?
  errorMessage         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status])
  @@index([sha256])
  @@index([parsedContractNumber])
  // One physical version is queued once; a replacement at the same path gets
  // its own record because its checksum changes.
  @@unique([sourcePath, sha256])
}

/// Immutable operational log for the import pipeline: it records automatic
/// scanner activity as well as actions made by a person in the UI.
model ImportEvent {
  id          String     @id @default(cuid())
  inboxItemId String?
  fileName    String
  event       String
  outcome     String
  message     String?
  contractId  String?
  actorId     String?
  actor       User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([inboxItemId, createdAt])
  @@index([contractId, createdAt])
  @@index([outcome, createdAt])
  @@index([createdAt])
}

// ------------------------------------------------------------
// АУДИТ И ПРАВА ДОСТУПА
// ------------------------------------------------------------

enum AuditAction {
  VIEW
  DOWNLOAD
  UPLOAD
  DELETE
  CREATE
  UPDATE
  LOGIN
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String // напр. "Document", "Contract"
  entityId   String
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Ежедневный фактический срез нагрузки отделов. Он не пересчитывает
/// прошлое задним числом: каждая строка — состояние системы на конкретный день.
model DepartmentDailySnapshot {
  id         String   @id @default(cuid())
  date       DateTime
  department String
  working    Int      @default(0)
  attention  Int      @default(0)
  paused     Int      @default(0)
  done       Int      @default(0)
  total      Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([date, department])
  @@index([department, date])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  lockToken String?
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

enum AccessLevel {
  READ
  WRITE
}

/// Точечные права VIEWER'а на конкретный договор
model ContractAccess {
  id         String      @id @default(cuid())
  contractId String
  contract   Contract    @relation(fields: [contractId], references: [id])
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  level      AccessLevel @default(READ)
  createdAt  DateTime    @default(now())

  @@unique([contractId, userId])
  @@index([contractId])
  @@index([userId])
}
